+/**
+ * v17：递归收集某个文件夹（含其所有下级子文件夹）里的全部歌曲。
+ * 供列表行首的方形播放按钮使用 —— 伍所选择"含子文件夹"的口径。
+ * 直接歌曲排在前、子文件夹歌曲按顺序接在后面，避免同一首歌重复。
+ */
+internal fun LibraryFolderTree.collectTracksRecursively(key: LibraryFolderKey): List<Track> {
+    val direct = directTracksByKey[key].orEmpty()
+    val children = childFoldersByKey[key].orEmpty()
+    if (children.isEmpty()) return direct
+    val nested = children.flatMap { collectTracksRecursively(it.key) }
+    if (nested.isEmpty()) return direct
+    val directIds = direct.mapTo(mutableSetOf()) { it.id }
+    return direct + nested.filterNot { it.id in directIds }
+}
