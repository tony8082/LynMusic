+/**
+ * 播放全部时从列表中间随机挑一首作为起始曲，而不是永远从第一首开始。
+ * 偏向中部 [15%, 85%] 区间、排除最前/最后，避免"每次都选第一首或前几首"。
+ */
+private fun randomMiddleStartIndex(size: Int): Int {
+    if (size <= 2) return 0
+    val lo = (size * 0.15).toInt().coerceAtLeast(1)
+    val hi = (size * 0.85).toInt().coerceAtMost(size - 2)
+    return if (hi >= lo) lo + Random.nextInt(hi - lo + 1) else 1 + Random.nextInt(size - 1)
+}
