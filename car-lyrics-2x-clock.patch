+package top.iwesley.lyn.music.automotive
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.Intent.FLAG_ACTIVITY_NEW_TASK
+import top.iwesley.lyn.music.readAutoStartOnBoot
+
+// 杞︽満寮€鏈鸿嚜鍚箍鎾帴鏀跺櫒锛氬紑鏈哄畬鎴愭垨搴旂敤鏇存柊鍚庯紝鑻ョ敤鎴峰湪璁剧疆椤靛紑鍚€滃紑鏈鸿嚜鍔ㄥ惎鍔ㄢ€濓紝鍒欐媺璧?MainActivity銆?+// 涓?player/app 涓?SettingsUi 鐨勨€滃紑鏈鸿嚜鍔ㄥ惎鍔ㄢ€濆紑鍏冲叡鐢ㄥ悓涓€浠?SharedPreferences 鍋忓ソ銆?+class AutoStartBootReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        when (intent.action) {
+            Intent.ACTION_BOOT_COMPLETED,
+            Intent.ACTION_MY_PACKAGE_REPLACED -> {
+                if (readAutoStartOnBoot(context)) {
+                    val launch = Intent(context, MainActivity::class.java).apply {
+                        addFlags(FLAG_ACTIVITY_NEW_TASK)
+                    }
+                    context.startActivity(launch)
+                }
+            }
+        }
+    }
+}
