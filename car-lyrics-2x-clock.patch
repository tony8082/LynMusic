+    private suspend fun createPlaylistAndAddTracks(
+        name: String,
+        tracks: List<Track>,
+    ) {
+        playlistRepository.createPlaylist(name)
+            .onSuccess { summary ->
+                observeSelectedPlaylist(summary.id)
+                if (tracks.isEmpty()) {
+                    updateState { it.copy(message = null) }
+                    return@onSuccess
+                }
+                val failedCount = tracks.count { track ->
+                    playlistRepository.addTrackToPlaylist(summary.id, track).isFailure
+                }
+                updateState {
+                    it.copy(
+                        message = failedCount
+                            .takeIf { count -> count > 0 }
+                            ?.let { count -> "$count 首歌曲未能加入歌单。" },
+                    )
+                }
+            }
+            .onFailure { throwable ->
+                updateState { it.copy(message = throwable.message.orEmpty().ifBlank { "歌单创建失败。" }) }
+            }
+    }
+
