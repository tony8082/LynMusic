+
+private fun TextStyle.scaleFont(scale: Float): TextStyle =
+    this.copy(fontSize = this.fontSize * scale)
+
+@Composable
+private fun AutomotiveClock(
+    scale: Float = 1.5f,
+    modifier: Modifier = Modifier,
+) {
+    val timeStr = remember { mutableStateOf("--:--") }
+    val dateStr = remember { mutableStateOf("") }
+    LaunchedEffect(Unit) {
+        while (true) {
+            val now = Clock.System.now().toLocalDateTime(TimeZone.currentSystemDefault())
+            timeStr.value = "${now.hour.toString().padStart(2, '0')}:${now.minute.toString().padStart(2, '0')}"
+            dateStr.value = "${now.year}年${now.monthNumber}月${now.dayOfMonth}日"
+            kotlinx.coroutines.delay(30_000)
+        }
+    }
+    Column(
+        modifier = modifier,
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.Center,
+    ) {
+        Text(
+            text = timeStr.value,
+            style = MaterialTheme.typography.displayMedium.copy(
+                fontSize = (64f * scale).sp,
+                fontWeight = FontWeight.ExtraBold,
+            ),
+            color = Color.White.copy(alpha = 0.96f),
+        )
+        Text(
+            text = dateStr.value,
+            style = MaterialTheme.typography.titleMedium.copy(
+                fontSize = (18f * scale).sp,
+            ),
+            color = Color.White.copy(alpha = 0.7f),
+        )
+    }
+}
